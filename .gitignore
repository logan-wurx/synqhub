/release/linux/
/sandbox-results/*
!/sandbox-results/.gitkeep
/release/old/

dist-web

# End-to-end test screenshots (CI artifacts)
e2e/screenshots/
# Filled in with this checkout's path by release/tools/render-docs.mjs (templates: *.wsb.template)
/release/sandbox-test/*.wsb
# Personal search terms for release/tools/leak-scan.mjs, kept on this PC only
/release/tools/leak-terms.local.txt
