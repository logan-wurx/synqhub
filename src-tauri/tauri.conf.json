{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SYNQ",
  "mainBinaryName": "synq",
  "version": "0.1.0",
  "identifier": "com.logan.onboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run build:helper",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SYNQ",
        "width": 1480,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#0f0f0f",
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --in-process-gpu --disable-gpu --enable-features=NetworkServiceInProcess2"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.steamstatic.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://usevia.app https://raw.githubusercontent.com",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.steamstatic.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 https://usevia.app https://raw.githubusercontent.com",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "object-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (C) 2026 logan-wurx",
    "license": "AGPL-3.0-or-later",
    "publisher": "logan-wurx",
    "homepage": "https://synqhub.app",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Every device. One system.",
    "resources": {
      "eq-engine/EqualizerAPO-x64-1.4.2.exe": "eq-engine/EqualizerAPO-x64-1.4.2.exe"
    },
    "windows": {
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
