# SYNQ: lets the signed-in user open the HID devices SYNQ supports (TAG+="uaccess"), and no others.
# GENERATED from the bridge's own device tables (src-tauri/src/udev.rs: hid.rs, brands.rs, brand_ids.rs,
# openmouse_ids.rs) by `node scripts/gen-udev-rules.mjs`. Do not edit: a test fails when this file and the
# tables disagree. What SYNQ reads and writes on these devices is still decided per collection and per
# report id by the app (keystrokes and mouse movement are never passed on).
# The .deb installs this file in /usr/lib/udev/rules.d; the AppImage can put it in /etc/udev/rules.d.
ACTION=="remove", GOTO="onboard_hub_end"
SUBSYSTEM!="hidraw", GOTO="onboard_hub_end"

# Devices in firmware-update mode are never SYNQ's.
KERNELS=="*:046D:0AD0.*", GOTO="onboard_hub_end"
KERNELS=="*:046D:0AD2.*", GOTO="onboard_hub_end"
KERNELS=="*:046D:0AD3.*", GOTO="onboard_hub_end"
KERNELS=="*:046D:0AD6.*", GOTO="onboard_hub_end"
KERNELS=="*:046D:AB24.*", GOTO="onboard_hub_end"
KERNELS=="*:3367:1977.*", GOTO="onboard_hub_end"
KERNELS=="*:373E:B01C.*", GOTO="onboard_hub_end"
KERNELS=="*:373E:B01D.*", GOTO="onboard_hub_end"
KERNELS=="*:373E:B01E.*", GOTO="onboard_hub_end"
KERNELS=="*:373E:B032.*", GOTO="onboard_hub_end"
KERNELS=="*:373E:B033.*", GOTO="onboard_hub_end"
KERNELS=="*:373E:B054.*", GOTO="onboard_hub_end"
KERNELS=="*:373E:B084.*", GOTO="onboard_hub_end"

# Whole vendors (OpenMouse's vendor-wide filters, Logitech, Wooting's analog collections).
KERNELS=="*:046D:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:093A:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:1915:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:1D57:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:25A7:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:2FE3:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:3151:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:31E3:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:3367:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:3434:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:3554:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:36A7:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:3710:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:372E:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:373B:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:373E:*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:3837:*", TAG+="uaccess", GOTO="onboard_hub_end"

# Single products (brand drivers, OpenMouse and keyboard-protocol ids, the hand-built panels, known VIA boards).
KERNELS=="*:0079:181A.*", TAG+="uaccess", GOTO="onboard_hub_end"
KERNELS=="*:0079:181B.*", TAG+="uaccess", GOTO="onboard_hub_end"
