{
  "name": "onboard-hub",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "One light app for mice, keyboards, controllers, headphones, monitors, webcams and RGB lights, without each maker's app.",
  "author": "logan-wurx",
  "homepage": "https://synqhub.app",
  "repository": { "type": "git", "url": "git+https://github.com/logan-wurx/synqhub.git" },
  "bugs": "https://github.com/logan-wurx/synqhub/issues",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "tsc && vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "test": "node --test scripts/*.test.ts",
    "build:helper": "node scripts/build-helper.mjs",
    "build:e2e": "tsc && vite build --mode e2e",
    "sims": "node scripts/run-sims.mjs",
    "gen:udev": "node scripts/gen-udev-rules.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@noble/ciphers": "2.4.0",
    "@number-flow/react": "^0.6.2",
    "@openmouse/keyboard-protocol": "1.1.0",
    "@openmouse/protocol": "^0.42.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
