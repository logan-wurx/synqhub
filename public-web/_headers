# Headers for static hosts that read a _headers file (Netlify, Cloudflare Pages). Other hosts: set the same ones.
# WebHID and Web Bluetooth (Govee lamps) are allowed for this origin only; nothing else in the page needs a permission.
# The page may reach SYNQ Helper on this PC (ws://127.0.0.1:17860, src/lib/web/helper.ts), VIA's keyboard
# definitions, and Cloudflare Web Analytics (its beacon script and its anonymous, cookieless visit counts), nothing else.
/*
  Permissions-Policy: hid=(self), bluetooth=(self), camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://usevia.app https://cloudflareinsights.com ws://127.0.0.1:17860; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
/assets/*
  Cache-Control: public, max-age=31536000, immutable
